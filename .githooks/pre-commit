#!/bin/sh
#
# Identity guard: refuse to create a commit under the retired identity.
#
# GitHub decides the Contributors list from the commit author EMAIL, not the
# name. An email verified on the old account will show that account in
# Contributors no matter what user.name says — so this guard checks both.
#
# Enabled per clone with:  git config core.hooksPath .githooks

# Matched case-insensitively as substrings, so "kochevnik" also covers
# "Kochevnik0" and its GitHub noreply address
# (289872613+Kochevnik0@users.noreply.github.com), which is the sneaky one:
# it carries the old account even when user.name looks fine.
BANNED_NAMES='kochevnik'
BANNED_EMAILS='jon\.khamidov@gmail\.com|kochevnik'

ident=$(git var GIT_AUTHOR_IDENT)
name=${ident%% <*}
email=${ident#*<}; email=${email%%>*}

fail() {
  echo "identity guard: commit blocked — $1" >&2
  echo "  author: $name <$email>" >&2
  echo "  fix:    git config user.name  \"<handle>\"" >&2
  echo "          git config user.email \"<email not verified on the old account>\"" >&2
  echo "  bypass: git commit --no-verify" >&2
  exit 1
}

echo "$name"  | grep -qiE "$BANNED_NAMES"  && fail "author name is the retired identity"
echo "$email" | grep -qiE "$BANNED_EMAILS" && fail "author email is linked to the retired account"

exit 0
