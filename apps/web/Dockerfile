FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@8.15.9 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/quant/package.json packages/quant/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
COPY packages/shared packages/shared
COPY packages/quant packages/quant
ARG VITE_OPSIS_WORKSPACES_ENABLED=false
ARG VITE_OPSIS_PUBLIC_ACCESS_ENABLED=false
ARG VITE_API_BASE_URL=
ARG VITE_CLOUD_WORKSPACE_ENABLED=false
ARG VITE_COLLECTIBLE_CATALOG_ENABLED=false
ARG VITE_MARKET_INVENTORY_ENABLED=false
ARG VITE_REPLAY_ACTIONS_ENABLED=false
ARG VITE_OPEN_DATA_API_ENABLED=false
ARG VITE_APPROVAL_MANAGER_ENABLED=false
ARG VITE_TRADE_SIMULATOR_ENABLED=false
ARG VITE_CARD_PRICE_CHECK_ENABLED=false
ARG VITE_WATCH_ENABLED=false
ARG VITE_KOL_TRACKER_ENABLED=false
ARG VITE_PORTFOLIO_STRESS_TEST_ENABLED=false
ARG VITE_SITUATION_ROOM_ENABLED=false
ARG VITE_OBSERVED_TRADES_ENABLED=false
ARG VITE_EXIT_CHECK_ENABLED=false
ARG VITE_OPSIS_RELEASE_STAGE=preview
ARG VITE_OPSIS_INDEXABLE=false
ARG VITE_BUILD_SHA
ARG VITE_PUBLIC_SITE_URL
ARG VITE_SUPPORT_EMAIL=
ARG VITE_SECURITY_EMAIL=
ARG RAILWAY_GIT_COMMIT_SHA
ARG RAILWAY_PUBLIC_DOMAIN
ENV VITE_OPSIS_WORKSPACES_ENABLED=$VITE_OPSIS_WORKSPACES_ENABLED
ENV VITE_OPSIS_PUBLIC_ACCESS_ENABLED=$VITE_OPSIS_PUBLIC_ACCESS_ENABLED
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_CLOUD_WORKSPACE_ENABLED=$VITE_CLOUD_WORKSPACE_ENABLED
ENV VITE_COLLECTIBLE_CATALOG_ENABLED=$VITE_COLLECTIBLE_CATALOG_ENABLED
ENV VITE_MARKET_INVENTORY_ENABLED=$VITE_MARKET_INVENTORY_ENABLED
ENV VITE_REPLAY_ACTIONS_ENABLED=$VITE_REPLAY_ACTIONS_ENABLED
ENV VITE_OPEN_DATA_API_ENABLED=$VITE_OPEN_DATA_API_ENABLED
ENV VITE_APPROVAL_MANAGER_ENABLED=$VITE_APPROVAL_MANAGER_ENABLED
ENV VITE_TRADE_SIMULATOR_ENABLED=$VITE_TRADE_SIMULATOR_ENABLED
ENV VITE_CARD_PRICE_CHECK_ENABLED=$VITE_CARD_PRICE_CHECK_ENABLED
ENV VITE_WATCH_ENABLED=$VITE_WATCH_ENABLED
ENV VITE_KOL_TRACKER_ENABLED=$VITE_KOL_TRACKER_ENABLED
ENV VITE_PORTFOLIO_STRESS_TEST_ENABLED=$VITE_PORTFOLIO_STRESS_TEST_ENABLED
ENV VITE_SITUATION_ROOM_ENABLED=$VITE_SITUATION_ROOM_ENABLED
ENV VITE_OBSERVED_TRADES_ENABLED=$VITE_OBSERVED_TRADES_ENABLED
ENV VITE_EXIT_CHECK_ENABLED=$VITE_EXIT_CHECK_ENABLED
ENV VITE_OPSIS_RELEASE_STAGE=$VITE_OPSIS_RELEASE_STAGE
ENV VITE_OPSIS_INDEXABLE=$VITE_OPSIS_INDEXABLE
ENV VITE_BUILD_SHA=$VITE_BUILD_SHA
ENV VITE_PUBLIC_SITE_URL=$VITE_PUBLIC_SITE_URL
ENV VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL
ENV VITE_SECURITY_EMAIL=$VITE_SECURITY_EMAIL
ENV RAILWAY_GIT_COMMIT_SHA=$RAILWAY_GIT_COMMIT_SHA
ENV RAILWAY_PUBLIC_DOMAIN=$RAILWAY_PUBLIC_DOMAIN
RUN pnpm --filter @rh-chain/shared build && pnpm --filter @rh-chain/quant build && pnpm --filter @rh-chain/web build

FROM nginx:1.30.4-alpine3.24@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46
# The base digest is intentionally pinned for reproducibility, then upgraded
# inside the same Alpine release so newly published security fixes are not
# deferred until the next upstream image digest refresh.
RUN apk upgrade --no-cache \
  && apk add --no-cache ca-certificates
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
ENV API_UPSTREAM_SCHEME=http
ENV API_UPSTREAM_HOST=api.railway.internal
ENV API_UPSTREAM_PORT=4000
ENV NGINX_ENVSUBST_FILTER=API_UPSTREAM_SCHEME|API_UPSTREAM_HOST|API_UPSTREAM_PORT|API_UPSTREAM_RESOLVER
ARG VITE_OPSIS_WORKSPACES_ENABLED=false
ENV OPSIS_PRIVATE_PREVIEW=$VITE_OPSIS_WORKSPACES_ENABLED
COPY apps/web/nginx.conf /etc/nginx/templates/default.conf.template
COPY apps/web/15-api-resolver.envsh /docker-entrypoint.d/15-api-resolver.envsh
COPY apps/web/40-opsis-preview-auth.sh /docker-entrypoint.d/40-opsis-preview-auth.sh
RUN chmod +x /docker-entrypoint.d/15-api-resolver.envsh /docker-entrypoint.d/40-opsis-preview-auth.sh
EXPOSE 80
