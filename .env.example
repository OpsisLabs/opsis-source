NODE_ENV=development
# Private launch: cloud research is deferred. Local encrypted chats need no DB.
CLOUD_WORKSPACE_ENABLED=false
VITE_CLOUD_WORKSPACE_ENABLED=false
BUILD_SHA=
PORT=4000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=
REDIS_URL=
CHAIN_CACHE_TTL_SECONDS=60
JWT_ACCESS_SECRET=replace_me_with_unique_access_secret_32_chars_minimum
JWT_REFRESH_SECRET=replace_me_with_unique_refresh_secret_32_chars_minimum
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
SECURE_SESSION_COOKIES=false
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=120000
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com
ROBINHOOD_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ENABLE_PUBLIC_RPC_FALLBACK=false
BLOCKSCOUT_API_BASE_URL=https://robinhoodchain.blockscout.com/api/v2
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_PRO_API_BASE_URL=https://api.blockscout.com
BLOCKSCOUT_PRO_API_KEY=
BLOCKSCOUT_CHAIN_ID=4663
BLOCKSCOUT_MAX_PAGES=3
ALCHEMY_API_KEY=
ALCHEMY_ROBINHOOD_RPC_URL=
ALCHEMY_ROBINHOOD_WS_URL=
UNISWAP_QUOTE_ENABLED=false
UNISWAP_API_KEY=
UNISWAP_API_BASE_URL=https://trade-api.gateway.uniswap.org/v1
UNISWAP_QUOTE_TIMEOUT_MS=8000
UNISWAP_QUOTE_CACHE_SECONDS=15
UNISWAP_QUOTE_BUDGET_PER_MINUTE=30
UNISWAP_QUOTE_RATE_LIMIT_PER_MINUTE=20
PRIVATE_MODE_ENABLED=true
PORTFOLIO_MODE_ENABLED=false
SCOUT_WATCH_ENABLED=false
VITE_SCOUT_WATCH_ENABLED=false
VITE_PORTFOLIO_STRESS_TEST_ENABLED=false
PORTFOLIO_DAILY_RPC_UNIT_BUDGET=5000
PORTFOLIO_MAX_RPC_SUBCALLS=64
RWA_VERIFY_ENABLED=false
RWA_DAILY_RPC_UNIT_BUDGET=3000
RWA_MAX_RPC_SUBCALLS=24
# Read-only Uniswap V3 factory/quoter exit estimate (default off, no secret).
EXIT_CHECK_ENABLED=false
VITE_EXIT_CHECK_ENABLED=false
EXIT_CHECK_DAILY_RPC_UNIT_BUDGET=2000
EXIT_CHECK_MAX_RPC_SUBCALLS=24
RATE_LIMIT_EXIT_CHECK_PER_HOUR=10
COLLECTIBLE_CATALOG_ENABLED=false
VITE_COLLECTIBLE_CATALOG_ENABLED=false
MARKET_INVENTORY_ENABLED=false
VITE_MARKET_INVENTORY_ENABLED=false
VITE_REPLAY_ACTIONS_ENABLED=false
MARKET_DAILY_REQUEST_BUDGET=1000
RATE_LIMIT_MARKET_PER_HOUR=12
OBSERVED_TRADES_ENABLED=false
VITE_OBSERVED_TRADES_ENABLED=false
OBSERVED_TRADES_DAILY_RPC_UNIT_BUDGET=3000
OBSERVED_TRADES_MAX_RPC_SUBCALLS=40
OBSERVED_TRADES_MAX_BLOCKS=1000
OBSERVED_TRADES_MIN_BLOCKS=50
OBSERVED_TRADES_MAX_LOGS=1000
OBSERVED_TRADES_TOP_ROWS=6
RATE_LIMIT_OBSERVED_TRADES_PER_HOUR=12
OPEN_DATA_API_ENABLED=false
VITE_OPEN_DATA_API_ENABLED=false
OPEN_DATA_DAILY_REQUEST_BUDGET=10000
RATE_LIMIT_OPEN_DATA_PER_HOUR=60
TCGDEX_API_BASE_URL=https://api.tcgdex.net/v2
COLLECTIBLE_DAILY_REQUEST_BUDGET=500
CSRF_PROTECTION_ENABLED=true
GOLDRUSH_ENABLED=false
GOLDRUSH_API_KEY=
GOLDRUSH_API_BASE_URL=https://api.covalenthq.com/v1
GOLDRUSH_CHAIN_NAME=robinhood-mainnet
PROVIDER_MAX_RETRIES=2
PROVIDER_BACKOFF_MS=150
PROVIDER_TIMEOUT_MS=10000
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_RESET_MS=30000
PROVIDER_REQUEST_BUDGET_PER_MINUTE=120
PROVIDER_MAX_CONCURRENCY=5
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RETENTION_ENABLED=true
RETENTION_INTERVAL_HOURS=24
RETENTION_AUTH_DAYS=30
RETENTION_SOURCE_DAYS=30
RETENTION_AUDIT_DAYS=90
RETENTION_USAGE_DAYS=90
RETENTION_CHAT_DAYS=365
RATE_LIMIT_AUTH_PER_HOUR=20
RATE_LIMIT_CHAT_PER_HOUR=30
RATE_LIMIT_LOOKUP_PER_HOUR=120
RATE_LIMIT_WALLET_PER_HOUR=20
RATE_LIMIT_PUBLIC_PER_HOUR=20
RATE_LIMIT_PORTFOLIO_PER_HOUR=10
RATE_LIMIT_RWA_PER_HOUR=10
RATE_LIMIT_COLLECTIBLE_PER_HOUR=10
QUOTA_AI_MESSAGES_PER_MONTH=500
QUOTA_CHAIN_LOOKUPS_PER_MONTH=5000
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_TOKEN=

# Source-linked Situation Room, dated public capture (default off).
VITE_SITUATION_ROOM_ENABLED=false

# Opsis queued preparation: isolated, access-restricted preview only.
# The access key is 32 random bytes encoded as 64 lowercase hex characters.
# Configure only its SHA-256 hash and an ISO UTC expiry on the server.
OPSIS_WORKSPACES_ENABLED=false
VITE_OPSIS_WORKSPACES_ENABLED=false
OPSIS_PREVIEW_HASH=
OPSIS_PREVIEW_EXPIRES_AT=
